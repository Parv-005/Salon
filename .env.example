# =====================================================================
# MANE RIOT® — Environment Variables Example
# Duplicate this file as .env and fill in your values
# =====================================================================

# 1. Meta / WhatsApp Webhook Token
VERIFY_TOKEN=barber_bot_verify_token

# 2. Supabase Cloud Integration (Optional - Falls back to SQLite if empty)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# 3. OpenAI API Key (Optional - Falls back to built-in rule engine if empty)
OPENAI_API_KEY=your-openai-api-key
